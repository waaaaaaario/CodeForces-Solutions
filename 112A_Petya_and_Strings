using namespace std;
using ll = long long;
using ld = long double;
using pii = pair<int, int>;

void solve() {
    string x, y;
    cin >> x >>y;
    for (int i=0; i < x.length(); i++){
    	x[i]=tolower(x[i]);
    	y[i]=tolower(y[i]);
    }
    if (x<y)
    cout << -1;
    else if(x>y)
    cout << 1;
    else
    cout <<0;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    solve();
    
    return 0;
}
